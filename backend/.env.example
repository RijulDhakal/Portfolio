# ============================================================
# Portfolio CMS - Environment Configuration
# Copy to .env and fill in your values. NEVER commit real secrets.
# ============================================================

# --- Database ---
POSTGRES_PASSWORD=portfolio
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=portfolio;Username=portfolio;Password=portfolio

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_ISSUER=Portfolio.Api
JWT_AUDIENCE=Portfolio.Cms

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Admin (used only on first seed) ---
# REQUIRED in production. The app refuses to boot without a strong value.
ADMIN_EMAIL=admin@rijuldhakal.com
# Generate with: openssl rand -base64 18
ADMIN_PASSWORD=

# --- Storage ---
# local | s3
STORAGE_PROVIDER=local
# Only for s3:
# STORAGE__CONNECTIONSTRING=
# STORAGE__BUCKET=
# STORAGE__ENDPOINT=
# STORAGE__CREDENTIALS__ACCESSKEY=
# STORAGE__CREDENTIALS__SECRETKEY=
